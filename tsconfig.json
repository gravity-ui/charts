{
  "extends": "@gravity-ui/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "allowJs": true,
    "outDir": "build/esm",
    "module": "esnext",
    "jsx": "react",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "~playwright/*": ["./playwright/*"],
      "~core/*": ["./src/core/*"],
      "@gravity-ui/charts": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "playwright/*",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "docs/examples/**/*.ts",
    "docs/examples/**/*.tsx"
  ]
}
